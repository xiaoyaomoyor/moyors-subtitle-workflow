        "segments": [
          {
            "id": "extension-1-segment-001",
            "start": 240,
            "end": 1600,
            "text": "Hello, the name's Jeddum,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-002",
            "start": 1680,
            "end": 3560,
            "text": "and today I'm going to show you how to set up",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-003",
            "start": 3560,
            "end": 7720,
            "text": "Unreal Engine five so that you can create your own stream game overlay",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-004",
            "start": 7720,
            "end": 9250,
            "text": "like this.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-005",
            "start": 11550,
            "end": 12230,
            "text": "bear in mind,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-006",
            "start": 12350,
            "end": 16110,
            "text": "this video will only cover how to output alpha from unreal engine and",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-007",
            "start": 16110,
            "end": 17910,
            "text": "how i got it working with obs.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-008",
            "start": 18190,
            "end": 20830,
            "text": "but this should apply to most broadcasting software.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-009",
            "start": 21310,
            "end": 23590,
            "text": "it's worth noting that if you're looking to create",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-010",
            "start": 23590,
            "end": 28430,
            "text": "a windows pit or windows assistant, this is a great start.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-011",
            "start": 28550,
            "end": 28870,
            "text": "however,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-012",
            "start": 28950,
            "end": 30990,
            "text": "you're going to need some windows hook to be able to",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-013",
            "start": 30990,
            "end": 32630,
            "text": "enable transparency in windows.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-014",
            "start": 32750,
            "end": 34030,
            "text": "i'm not going to cover that in this video,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-015",
            "start": 34110,
            "end": 35670,
            "text": "but if that's something you're interested in,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-016",
            "start": 35750,
            "end": 38390,
            "text": "please drop a comment and i will get to work on making that",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-017",
            "start": 38390,
            "end": 39590,
            "text": "happen as soon as i can.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-018",
            "start": 40380,
            "end": 41220,
            "text": "with that being said,",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-019",
            "start": 41300,
            "end": 42380,
            "text": "that should be enough jibber-jibber.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-020",
            "start": 42500,
            "end": 44140,
            "text": "let's just jump straight into it.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-021",
            "start": 44620,
            "end": 45820,
            "text": "all right, so here we are.",
            "_dirty": true
          },
          {
            "id": "extension-1-segment-022",
            "start": 46260,
            "end": 47300,
            "text": "let's create a new project.",
            "_dirty": true
